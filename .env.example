# Public domain for Caddy / production HTTPS.
DOMAIN=ccc.example.com

# Authentication.
AUTH_SECRET_KEY=replace-me-with-a-long-random-secret
AUTH_COOKIE_SECURE=true
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=choose-a-password-8+chars

# LLM provider keys.
OPENAI_API_KEY=
DEEPINFRA_API_KEY=
GEMINI_API_KEY=

# Optional user-test controls.
# Leave DEFAULT_MODEL empty to require an explicit model choice.
DEFAULT_MODEL=
DEEP_RESEARCH_MAX_POLL_SECONDS=1800
NEXT_PUBLIC_LOCK_LLM_MODEL=false
NEXT_PUBLIC_ENABLE_LLM_CONSOLE=true
